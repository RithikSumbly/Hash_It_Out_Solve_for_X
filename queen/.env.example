# The Red Queen's server. On Hugging Face, set these as Space secrets and variables, never in code.

# Required
GEMINI_API_KEY=              # Google AI Studio key
DEMO_PRIVATE_KEY=            # her own TEST wallet on Base Sepolia (attacks, proposals, closes, top-ups); never a real-money key

# Optional
GEMINI_API_KEY_2=            # a second key, tried when the first is rate-limited
GEMINI_LITE_MODELS=          # comma list, default gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
GEMINI_DEEP_MODELS=          # comma list, default gemini-3.8-flash,gemini-3.6-flash,gemini-3-flash,gemini-2.5-flash
PRESENTER_KEY=               # any long random string; ?presenter=<it> lifts rate limits on that device
RPC_URL=https://sepolia.base.org
LOGS_RPC_URL=
DAILY_BUDGET=                # model calls a day (default 900 per key)
FILM_PER_HOUR=30
KEEP_WATCHED_S=300
KEEP_SPAR=1
TOPUP_ETH=0.0005
TOPUP_PER_DAY=8
