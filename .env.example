# ---------------------------------------------------------------- chain
# The live arena runs on Base Sepolia, chain 84532: `npm run deploy:base` (see docs/DEPLOYMENT.md).
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Ethereum Sepolia is also supported. For any other EVM testnet use `--network custom` with CUSTOM_RPC_URL/CUSTOM_CHAIN_ID.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CUSTOM_RPC_URL=
CUSTOM_CHAIN_ID=
ETHERSCAN_API_KEY=

# Deployer (also the default Vault registrar). Use a TEST wallet only; never commit a real key.
DEPLOYER_PRIVATE_KEY=

# ---------------------------------------------------------------- deploy tuning (optional)
EPOCH_LENGTH=            # blocks; empty = the network default (Base Sepolia 600 = 2 min at 0.2 s a block, Sepolia 20 = 4 min)
REVEAL_WINDOW=           # empty = the default (Base Sepolia 100, else a quarter of the round)
VAULT_FUNDS=             # ETH in the vault; empty = 0.004 on public chains (the genesis policy refuses large drains from the first block)
POOL_FUNDS=              # ETH for closers' tips and compensation; empty = 0.0005 on public chains
IDENTITY_REGISTRY=       # an ERC-8004 Identity Registry; a mock is deployed if empty
REGISTRARS=              # comma-separated, e.g. the top-up service's wallet
GUARDIAN=                # optional: a wallet that may veto held payments

# ---------------------------------------------------------------- relay + bots (they read deployments/<CHAIN_ID>.json)
CHAIN_ID=11155111
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
RELAY_PORT=8787
RELAY_ADMIN_TOKEN=change-me
REPLAY_MINUTES=10
REPLAY_SPEED=4
STALL_SECONDS=75

BOT_MNEMONIC=            # 20 bot wallets are derived from this (see bots/src/env.ts ROLES)
BOT_TICK_MS=3000
BOT_RECYCLE=1            # attackers deposit extractions back so the vault keeps running
BOT_TARGET_ETH=0.3

TOPUP_PRIVATE_KEY=       # top-up service wallet (must be a Vault registrar); defaults to the deployer
TOPUP_PORT=8788
TOPUP_ETH=0.05
TOPUP_MIN_ETH=0.02

# ---------------------------------------------------------------- arena (web/.env.local)
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_RELAY_URL=ws://localhost:8787
NEXT_PUBLIC_TOPUP_URL=http://localhost:8788
