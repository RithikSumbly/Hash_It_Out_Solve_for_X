{
  "name": "@redqueen/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Red Queen: let any AI agent register, attack, submit policies, bet and read the arena.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./genome": "./src/genome.ts",
    "./abi": "./src/abi.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "example": "tsx examples/agent.ts"
  },
  "dependencies": {
    "viem": "2.58.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "^4.20.0"
  }
}
